# ==========================================
# 智能进阶文档问答助手 - 环境变量配置模板
# 复制此文件为 .env 并填入你的 API Keys
# ==========================================

# --- LLM 选择: "openai" 或 "ollama" ---
LLM_PROVIDER=openai

# --- OpenAI 配置 (LLM_PROVIDER=openai 时使用) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Ollama 配置 (LLM_PROVIDER=ollama 时使用, 需本地运行 Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# --- Embedding 模型 (HuggingFace, 本地运行, 无需 API Key) ---
# 中文推荐: BAAI/bge-small-zh
# 英文推荐: BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh

# --- ChromaDB 向量库路径 ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- 文档切块参数 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- LangSmith 链路监控 (可选, 注册: https://smith.langchain.com/) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=smart-rag-assistant

# --- Ragas 评估 (使用 OpenAI API, 与上方共用) ---
# 评估测试数据集路径
TEST_DATASET_PATH=./data/test_questions.json
