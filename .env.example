# ==========================================
# 智能进阶文档问答助手 - 环境变量配置模板
# 复制此文件为 .env 并填入你的 API Keys
# ==========================================

# --- LLM 选择: "openai" 或 "ollama" ---
LLM_PROVIDER=openai

# --- OpenAI 配置 (LLM_PROVIDER=openai 时使用) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# --- Ollama 配置 (LLM_PROVIDER=ollama 时使用, 需本地运行 Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# --- Embedding 模型 (FlagEmbedding, 本地运行, 无需 API Key) ---
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

# --- FAISS 向量索引路径 ---
FAISS_INDEX_DIR=./data/faiss_index
FAISS_INDEX_TYPE=Flat

# --- 文档切块参数 ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- 检索 / 重排 ---
RETRIEVAL_MODE=hybrid
HYBRID_ALPHA=0.75
HYBRID_FETCH_K=30
RETRIEVER_K=5
RERANK_ENABLED=true
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_FETCH_K=20
RERANK_TOP_N=5
RERANK_LOW_SCORE_THRESHOLD=0.0
QUERY_REWRITE_ENABLED=true
HOT_QUERY_CACHE_ENABLED=true
RETRIEVAL_SLOW_THRESHOLD_MS=3000

# --- LangSmith 链路监控 (可选, 注册: https://smith.langchain.com/) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGCHAIN_PROJECT=smart-rag-assistant

# --- Ragas 评估 (使用 OpenAI API, 与上方共用) ---
# 评估测试数据集路径
TEST_DATASET_PATH=./data/test_questions.json
